# ==============================================================================
# SecurePM Environment Configuration Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# Database Settings
POSTGRES_USER=securepm
POSTGRES_PASSWORD=securepm
POSTGRES_DB=securepm
POSTGRES_PORT=5432

# Bootstrap Administrator
# Used on initial startup to create the default 'admin' account
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow123!

# Application Domain (used for local HTTPS reverse proxy)
APP_DOMAIN=pm.local
HTTP_PORT=80
HTTPS_PORT=443
